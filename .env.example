# 复制为 .env 并按需修改。全部字段说明见 .env 内注释。
DATABASE_URI=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=sk-local
LOCAL_LLM_MODEL_ID=your-model-name
LOCAL_LLM_ENABLE_THINKING=true
LOCAL_LLM_STREAM_REASONING=true
COMPLETION_WEBHOOK_URL=/webhooks/run-complete
RUN_COMPLETE_WEBHOOK_SECRET=change-me-run-complete
OPEN_SWE_LOCAL_AUTH_TOKEN=change-me-auth
DASHBOARD_JWT_SECRET=change-me-jwt
CONFIGURED_ADMINS=
OPEN_SWE_USER_REGISTRY=1
SANDBOX_TYPE=docker
DOCKER_SANDBOX_IMAGE=python:3.12-slim
DEFAULT_REPO_OWNER=
DEFAULT_REPO_NAME=
OPEN_SWE_LLM_MAX_CONCURRENCY=1
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000
DASHBOARD_BASE_URL=http://localhost:3000
OPEN_SWE_QUEUE_DEBUG=0

# ===== 遥测(本地变体:禁 LangSmith 外发,纯自托管)=====
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
